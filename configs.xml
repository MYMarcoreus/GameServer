    <!--
        %l    日志级别
        %i    线程id
        %c    日志内容
        %t    日志时间，以产生日志的时间为准
        %f    产生日志的代码文件
        %L    产生日志的代码所在行数
        %n    换行符
        %T    输出Tab
        %p    输出百分号%
-->

    <log> good description
        <logger m_TypeName  = "default"
                level = "debug"
                is_async = "true" >
            <appender
                    type = "stdout"
                    format="[%t][%l][%i][%f:%L] %c%n"
                    time_format="%Y-%m-%d %H:%M:%S."
                    time_use_us="true" >
                description
                    <!-- format="[%t](%l) %c%n"-->
            </appender>
            <appender
                    type = "file"
                    format="[%t][%l][%i][%f:%L] %c%n"
                    time_format="%Y-%m-%d %H:%M:%S."
                    time_use_us="true">
            </appender>
        </logger>

        <logger m_TypeName  = "b"
